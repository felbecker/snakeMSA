{
    "name": "learnMSA",
    "tools": {
      "learnMSA" : {
        "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
        "params": [
          "-i {input}",
          "-o {output}",
          "-n 10",
          "--cluster_dir {workdir}"
        ]
      },
      "learnMSA_legacy" : {
        "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
        "params": [
          "-i {input}",
          "-o {output}",
          "-n 10",
          "--no_sequence_weights",
          "--unaligned_insertions"
        ]
      },
      "learnMSA2" : {
          "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
          "params": [
            "-i {input}",
            "-o {output}",
            "-n 4",
            "--use_language_model",
            "--cluster_dir {workdir}"
          ]
      }
    },
    "data_path": "data/homfam",
    "use_gpu": 1,
    "align_threads": 32,
    "align_mem": 64000
}
