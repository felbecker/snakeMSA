{
    "name": "learnMSA",
    "tools": {
      "learnMSA" : {
        "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
        "params": [
          "-i {input}",
          "-o {output}",
            "--work_dir {workdir}",
	    "--save_model"
        ]
      },
	"learnMSA_mea" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--work_dir {workdir}",
		"--save_model",
		"--pre_training_checkpoint",
		"--decode mea"
	    ]
	},
	"learnMSA_10" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--work_dir {workdir}",
		"--save_model",
		"--pre_training_checkpoint",
		"-n 10"
	    ]
	},
	"learnMSA2_10" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--use_language_model",
		"--work_dir {workdir}",
		"--save_model",
		"--pre_training_checkpoint",
		"-n 10"
	    ]
	},
	"learnMSA_iter1" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--work_dir {workdir}",
		"--max_iterations 1",
		"--save_model"
	    ]
	},
      "learnMSA2" : {
          "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
          "params": [
            "-i {input}",
            "-o {output}",
            "--use_language_model",
              "--work_dir {workdir}",
	      "--save_model"
          ]
      },
	"learnMSA2_mea" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--use_language_model",
		"--work_dir {workdir}",
		"--save_model",
		"--pre_training_checkpoint",
		"--decode mea"
	    ]
	},
	"learnMSA2_iter1" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--use_language_model",
		"--work_dir {workdir}",
		"--max_iterations 1",
		"--save_model"
	    ]
	}
    },
    "data_path": "data/homfam",
    "use_gpu": 1,
    "align_threads": 32,
    "align_mem": 64000,
    "align_runtime": "12h"
}
