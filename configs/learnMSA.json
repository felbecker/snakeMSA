{
    "name": "learnMSA",
    "tools": {
      "learnMSA" : {
        "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
        "params": [
          "-i {input}",
          "-o {output}",
          "--cluster_dir {workdir}"
        ]
      },
	"learnMSA_reset_em" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--reset_emissions_after_surgery",
		"--cluster_dir {workdir}",
		"--pre_training_checkpoint"
	    ]
	},
	"learnMSA_reset_trans" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--reset_transitions_after_surgery",
		"--cluster_dir {workdir}",
		"--pre_training_checkpoint"
	    ]
	},
	"learnMSA_reset_em_trans" : {
	    "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
	    "params": [
		"-i {input}",
		"-o {output}",
		"--cluster_dir {workdir}",
		"--reset_emissions_after_surgery",
		"--reset_transitions_after_surgery",
		"--pre_training_checkpoint"
		
	    ]
	},
      "learnMSA2" : {
          "command": "conda run --live-stream -n learnMSA_env python ../learnMSA/learnMSA.py",
          "params": [
            "-i {input}",
            "-o {output}",
            "--use_language_model",
            "--cluster_dir {workdir}"
          ]
      }
    },
    "data_path": "data/homfam",
    "use_gpu": 1,
    "align_threads": 32,
    "align_mem": 64000,
    "align_runtime": "12h"
}
