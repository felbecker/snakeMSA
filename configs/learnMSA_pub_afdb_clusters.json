{
    "name": "learnMSA_pub_afdb_clusters",
    "tools": {
      "learnMSA_replica_1" : {
        "command": "conda run --live-stream -n learnMSA python ../learnMSA/learnMSA.py",
        "params": [
          "-i {input}",
          "-o {output}",
          "--work_dir {workdir}",
          "--save_model",
          "--seed 0"
        ]
      },
      "learnMSA_struct_replica_1" : {
        "command": "conda run --live-stream -n learnMSA python ../learnMSA/learnMSA.py",
        "params": [
          "--struct {pdb}",
          "-o {output}",
          "--work_dir {workdir}",
          "--save_model",
          "--seed 0"
        ]
      }
    },
    "data_path": "data/afdb-clusters-test",
    "pdb": "pdb",
    "use_gpu": 1,
    "align_threads": 32,
    "align_mem": 32000,
    "score_threads": 6,
    "score_mem": 3000,
    "align_runtime": "4h"
}
