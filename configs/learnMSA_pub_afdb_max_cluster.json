{
    "name": "learnMSA_pub_afdb_max_cluster",
    "tools": {
      "learnMSA_struct_replica_1" : {
        "command": "conda run --live-stream -n learnMSA python ../learnMSA/learnMSA.py",
        "params": [
          "--struct {pdb}",
          "-o {output}",
          "--work_dir {workdir}",
          "--save_model",
          "--seed 0"
        ]
      },
      "learnMSA_struct_replica_2" : {
        "command": "conda run --live-stream -n learnMSA python ../learnMSA/learnMSA.py",
        "params": [
          "--struct {pdb}",
          "-o {output}",
          "--work_dir {workdir}",
          "--save_model",
          "--seed 1"
        ]
      },
      "learnMSA_struct_replica_3" : {
        "command": "conda run --live-stream -n learnMSA python ../learnMSA/learnMSA.py",
        "params": [
          "--struct {pdb}",
          "-o {output}",
          "--work_dir {workdir}",
          "--save_model",
          "--seed 2"
        ]
      }
    },
    "data_path": "data/afdb_max_cluster",
    "pdb": "pdb",
    "ref_pdb": "ref_pdb",
    "use_gpu": 1,
    "align_threads": 32,
    "align_mem": 32000,
    "score_threads": 6,
    "score_mem": 3000,
    "align_runtime": "4h",
    "lddt_muscle_only": false
}
