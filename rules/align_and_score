# type: ignore
#
# Cleanup mode (config "cleanup": true): align and score a sample in a single
# job, then delete its MSA, projection and work dir. Separate align and
# score_msa jobs could let many alignments pile up before their scoring runs,
# which overflows storage in large experiments. Scores and benchmarks are
# written to the same files as in the default mode, so concat_scores and the
# results file are unchanged.
import shutil
from types import SimpleNamespace


def runtime_minutes(value):
    """Runtime resource in minutes; ints are minutes, strings like "2h" are
    parsed the way snakemake parses them."""
    if isinstance(value, (int, float)):
        return int(value)
    from humanfriendly import parse_timespan
    return max(int(round(parse_timespan(value) / 60)), 1)


if CLEANUP:
    rule align_and_score:
        input:
            unaligned=data_file("unaligned", "{sample}")
        output:
            score="outputs/"+config["name"]+"/{tool}/scores/{sample}.score",
            # written by hand: the benchmark directive would also time the
            # scoring, unlike the align rule's benchmark
            bench="outputs/"+config["name"]+"/{tool}/benchmarks/{sample}.txt"
        threads: config.get("align_threads", 8)
        resources:
            mem_mb = max(
                config.get("align_mem", 64000), config.get("score_mem", 16000)
            ),
            gpu = lambda _: 1 if config["use_gpu"] else 0,
            runtime = (
                runtime_minutes(config.get("align_runtime", "1d"))
                + runtime_minutes(config.get("score_runtime", "10m"))
            )
        log:
            stdout="outputs/"+config["name"]+"/{tool}/logs/{sample}.log",
            stderr="outputs/"+config["name"]+"/{tool}/logs/{sample}.err",
            score_stdout=(
                "outputs/"+config["name"]+"/{tool}/logs/score_{sample}.log"
            ),
            score_stderr=(
                "outputs/"+config["name"]+"/{tool}/logs/score_{sample}.err"
            ),
        params:
            # intermediate files, deleted at the end of the job
            msa="outputs/"+config["name"]+"/{tool}/alignments/{sample}",
            proj="outputs/"+config["name"]+"/{tool}/projections/{sample}",
            workdir="outputs/"+config["name"]+"/{tool}/workdirs/{sample}/",
            tree="outputs/"+config["name"]+"/{tool}/trees/{sample}.dnd",
            struct=resolve_struct_path,
            emb=resolve_emb_path,
            pdb=resolve_pdb_path,
            ref=resolve_ref_path,
            lddt_muscle_only=bool(config.get("lddt_muscle_only", False)),
            gpu_bench=(
                "outputs/"+config["name"]+"/{tool}/benchmarks/{sample}.gpu"
            ),
            tool_bench=(
                "outputs/"+config["name"]+"/{tool}/benchmarks/{sample}.time"
            )
        run:
            from snakemake.benchmark import (
                benchmarked, write_benchmark_records
            )

            os.makedirs(os.path.dirname(params.msa), exist_ok=True)
            try:
                # Same measurement snakemake wraps around the run block of
                # the align rule (this process and its children), restricted
                # to the alignment.
                with benchmarked() as bench_record:
                    align_sample(
                        SimpleNamespace(unaligned=input.unaligned),
                        SimpleNamespace(msa=params.msa),
                        params,
                        SimpleNamespace(stdout=log.stdout, stderr=log.stderr),
                        threads,
                        wildcards,
                    )
                bench_record.jobid = jobid
                bench_record.rule_name = rule
                bench_record.wildcards = wildcards
                bench_record.params = params
                bench_record.resources = resources
                bench_record.input = input
                bench_record.threads = threads
                write_benchmark_records(
                    [bench_record],
                    output.bench,
                    workflow.output_settings.benchmark_extended,
                )

                score_sample(
                    SimpleNamespace(est=params.msa),
                    SimpleNamespace(proj=params.proj, score=output.score),
                    params,
                    SimpleNamespace(
                        stdout=log.score_stdout, stderr=log.score_stderr
                    ),
                    threads,
                    wildcards,
                )
            finally:
                # also on failure, so that failed jobs cannot fill the disk
                for path in (params.msa, params.proj):
                    if os.path.exists(path):
                        os.remove(path)
                if os.path.exists(params.workdir):
                    remove_tree(params.workdir)
