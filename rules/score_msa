# type: ignore

GPU_MEM_COLUMN = "max_gpu_mem"
TOOL_TIME_COLUMN = "tool_s"


def lookup_coverage(lookup_path, msa_path):
    """Find MSA headers that have no entry in a foldmason database lookup.

    foldmason resolves every MSA header through <db>.lookup, and a miss returns
    SIZE_MAX, so msa2lddt aborts with nothing but
    "Invalid database read for id=18446744073709551615". Lookup names come from
    the PDB file stem, while structure-aware aligners often append a chain id
    ("..._A"), which silently costs a whole benchmark its LDDT column. Checking
    here turns that into a message naming the offending headers.

    Returns (n_missing, n_total, first few missing headers).
    """
    with open(lookup_path) as lookup_file:
        names = {
            fields[1]
            for fields in (line.rstrip("\n").split("\t") for line in lookup_file)
            if len(fields) > 1
        }
    with open(msa_path) as msa_file:
        headers = [
            line[1:].split()[0]
            for line in msa_file
            if line.startswith(">") and line[1:].split()
        ]
    missing = [h for h in headers if h not in names]
    return len(missing), len(headers), missing[:3]


def normalize_msa(src_path, dst_path):
    """Copy an MSA, rewriting it as plain aligned FASTA (all gaps are "-" and
    all residues are uppercase).
    """
    with open(src_path) as src_file, open(dst_path, "w") as dst_file:
        for line in src_file:
            if line.startswith(">"):
                dst_file.write(line)
            else:
                dst_file.write(line.replace(".", "-").upper())


def chain_length_coverage(db_prefix, msa_path):
    """Find MSA rows whose residue count disagrees with the structure database.

    foldmason derives the chain length from the MSA row itself and passes it to
    Coordinate16::read without ever checking it against the stored entry, so a
    row that is too long walks off the end of the mmap. Catch the mismatch here
    rather than as a flaky segfault inside msa2lddt.

    Returns (n_mismatched, n_total, first few "name (msa vs db)" descriptions).
    """
    keys = {}
    with open(db_prefix + ".lookup") as lookup_file:
        for line in lookup_file:
            fields = line.rstrip("\n").split("\t")
            if len(fields) > 1:
                keys[fields[1]] = fields[0]

    # DBReader entries carry a trailing newline and null terminator
    lengths = {}
    with open(db_prefix + ".index") as index_file:
        for line in index_file:
            fields = line.rstrip("\n").split("\t")
            if len(fields) > 2:
                lengths[fields[0]] = int(fields[2]) - 2

    mismatched = []
    total = 0
    name = None
    residues = 0

    def check(name, residues):
        if name is None:
            return
        db_len = lengths.get(keys.get(name))
        if db_len is not None and db_len != residues:
            mismatched.append("%s (%d vs %d)" % (name, residues, db_len))

    with open(msa_path) as msa_file:
        for line in msa_file:
            if line.startswith(">"):
                check(name, residues)
                header = line[1:].split()
                name = header[0] if header else None
                residues = 0
                total += 1
            elif name is not None:
                # count the way foldmason's contract() does: everything
                # that is not "-" is a residue, dots included
                residues += sum(1 for c in line.strip() if c != "-")
    check(name, residues)
    return len(mismatched), total, mismatched[:3]


def restrict_msa_to_structures(msa_path, struct_dir, dst_path):
    """Write the sub-alignment of the rows that have a structure in struct_dir.

    Used with "ref_pdb": the structure scores are then computed on a subset
    of the structures that were aligned, as if the aligner had produced just
    these rows. Rows are matched by name to the structure file stems, the way
    foldmason's lookup does. Columns that are gaps in every kept row are
    dropped; "." counts as a residue here, as it does in foldmason.

    Returns (n_missing, n_structures, first few structures without a row).
    """
    names = {os.path.splitext(f)[0] for f in os.listdir(struct_dir)}
    records = []
    keep = False
    with open(msa_path) as msa_file:
        for line in msa_file:
            if line.startswith(">"):
                header = line[1:].split()
                keep = bool(header) and header[0] in names
                if keep:
                    records.append([line, header[0], []])
            elif keep:
                records[-1][2].append(line.strip())

    rows = ["".join(parts) for _, _, parts in records]
    cols = [
        i for i, column in enumerate(zip(*rows))
        if any(c != "-" for c in column)
    ]
    with open(dst_path, "w") as dst_file:
        for (header_line, _, _), row in zip(records, rows):
            dst_file.write(header_line)
            dst_file.write("".join(row[i] for i in cols) + "\n")

    missing = sorted(names - {name for _, name, _ in records})
    return len(missing), len(names), missing[:3]


def merge_benchmark_column(bench_path, suffix, column):
    """Append a sidecar value to a snakemake benchmark file as a new column.

    The align rule cannot write these itself: snakemake overwrites the
    benchmark file after the rule returns, so values like the peak GPU memory
    (".gpu") and the time of the tool process alone (".time") are parked in a
    sibling file and folded in here. Benchmark files without the sidecar
    (e.g. from runs made before it existed) get -1. Idempotent, so re-running
    this rule does not add the column twice.
    """
    with open(bench_path) as bench_file:
        lines = bench_file.read().splitlines()
    if not lines or column in lines[0].split("\t"):
        return

    sidecar_path = os.path.splitext(bench_path)[0] + suffix
    try:
        with open(sidecar_path) as sidecar_file:
            value = sidecar_file.read().strip() or "-1"
    except FileNotFoundError:
        value = "-1"

    lines[0] += "\t" + column
    for i in range(1, len(lines)):
        lines[i] += "\t" + value

    # write via a temporary file so a crash cannot truncate the benchmark
    tmp_path = bench_path + ".tmp"
    with open(tmp_path, "w") as tmp_file:
        tmp_file.write("\n".join(lines) + "\n")
    os.replace(tmp_path, bench_path)


def resolve_ref_path(wildcards):
    ref_path = data_file("aligned", wildcards.sample)
    return ref_path if os.path.exists(ref_path) else ""


def resolve_ref_pdb_path(wildcards):
    """Structures to score against, if they are not all of "pdb".

    With "ref_pdb", <data_path>/<ref_pdb>/<sample> holds a subset of the
    structures in "pdb" (e.g. a diverse sample of a huge cluster, where
    scoring every pair would take days). The aligners still get all of "pdb".
    """
    if "ref_pdb" not in config:
        return ""
    return data_file(config["ref_pdb"], os.path.splitext(wildcards.sample)[0])


def score_sample(input, output, params, log, threads, wildcards):
    """Score the MSA input.est, writing output.proj and output.score.

    Shared by the score_msa rule and the fused align_and_score rule (cleanup
    mode). The arguments only need attribute access to the fields used here;
    the shell() calls format against these parameter names.
    """
    # Ensure log directory exists before any shell calls write to it
    os.makedirs(os.path.dirname(log.stdout), exist_ok=True)

    msa_failed = False
    # binary mode: the MSA may be gzip compressed (learnMSA --compress)
    with open(input.est, "rb") as est_file:
        if est_file.readline().strip() == b"FAILED":
            msa_failed = True

    # strip the extension from the sample name
    sample_name = os.path.basename(wildcards.sample).rsplit('.', 1)[0]

    # Create folders if they do not exist
    os.makedirs(os.path.dirname(output.proj), exist_ok=True)
    os.makedirs(os.path.dirname(output.score), exist_ok=True)

    if not msa_failed:

        success_flag = 1
        if params.ref == "":
            # no reference MSA available: skip projection/FastSP scoring.
            # foldmason treats "." as residues
            normalize_msa(input.est, output.proj)
            values = ['-1'] * 7
        else:
            # first project the estimated msa w.r.t. the reference sequences
            shell(
                "python tools/project_msa.py"
                + " --msa {input.est}"
                + " --ref {params.ref}"
                + " --out {output.proj}"
                + " >> {log.stdout} 2>> {log.stderr}"
            )
            # compute scores
            fastsp_output = shell(
                "java -jar FastSP/FastSP.jar -r {params.ref} -e {output.proj} -mlr"
                + " 2>> {log.stderr}",
                read=True
            )
            # write it with the scores into a single line
            values = [
                line.split()[1] for line in fastsp_output.strip().split('\n')
            ]

        # compute lddt scores using foldmason and pylddt, against all
        # structures or, with ref_pdb, against the reference subset only
        struct_dir = params.ref_pdb or params.pdb
        struct_msa = output.proj
        if params.ref_pdb and os.path.exists(struct_dir):
            os.makedirs(params.workdir, exist_ok=True)
            struct_msa = params.workdir + "ref_pdb_msa.fa"
            n_missing, n_ref, examples = restrict_msa_to_structures(
                output.proj, struct_dir, struct_msa
            )
            if n_missing:
                # pylddt only rejects rows without a structure, so a missing
                # reference structure would silently shrink the subset
                warning = (
                    f"WARNING: structure scores unavailable for "
                    f"{sample_name}, recording -1: {n_missing}/{n_ref} "
                    f"ref_pdb structures have no MSA row (e.g. {examples})"
                )
                print(warning)
                with open(log.stderr, "a") as err_file:
                    print(warning, file=err_file)
                struct_dir = ""
        if struct_dir == "":
            lddt = "-1"
            lddt_core = "-1"
            lddt_muscle = "-1"
            dali_z = "-1"
        else:
            if not os.path.exists(struct_dir):
                lddt = "-1"
                lddt_core = "-1"
                lddt_muscle = "-1"
                dali_z = "-1"
            else:
                os.makedirs(params.workdir, exist_ok=True)
                if params.lddt_muscle_only:
                    # only pylddt's muscle LDDT is requested; foldmason is
                    # the expensive part, so skip it entirely
                    lddt = "-1"
                    lddt_core = "-1"
                else:
                    # foldmason (msa2lddt in particular) can segfault on certain
                    # inputs due to bugs in the upstream binary; don't let that
                    # abort the whole run, just record -1 for this sample.
                    # The reason always goes to the log: a systematic failure
                    # here turns the whole lddt column into -1, which is easy
                    # to mistake for "not requested" if nothing says otherwise.
                    try:
                        shell(
                            "conda run -n foldmason foldmason createdb {struct_dir} {params.workdir}foldmason_db"
                            + " --threads {threads}"
                            + " >> {log.stdout} 2>> {log.stderr}"
                        )
                        # Catch a name mismatch between the aligner and the
                        # database before msa2lddt turns it into a bare
                        # SIZE_MAX id (see lookup_coverage).
                        n_missing, n_total, examples = lookup_coverage(
                            params.workdir + "foldmason_db.lookup", struct_msa
                        )
                        if n_missing:
                            raise RuntimeError(
                                f"{n_missing}/{n_total} MSA headers absent from "
                                f"foldmason_db.lookup (e.g. {examples}) -- the "
                                "aligner and foldmason disagree on sequence names"
                            )
                        # Catch a residue-count mismatch before msa2lddt
                        # turns it into an out-of-bounds read (see
                        # chain_length_coverage).
                        n_bad, n_rows, bad_examples = chain_length_coverage(
                            params.workdir + "foldmason_db", struct_msa
                        )
                        if n_bad:
                            raise RuntimeError(
                                f"{n_bad}/{n_rows} MSA rows disagree with the "
                                f"foldmason database on residue count "
                                f"(e.g. {bad_examples}) -- msa2lddt would read "
                                "past the end of the C-alpha entries"
                            )
                        # Standard foldmason LDDT
                        lddt_output = shell(
                            "conda run -n foldmason foldmason msa2lddt {params.workdir}foldmason_db {struct_msa}"
                            + " --threads {threads}"
                            + " 2>> {log.stderr}",
                            read=True
                        )
                        lddt_match = next((
                            line for line in lddt_output.splitlines()
                            if line.startswith("Average MSA LDDT:")
                        ), None)
                        lddt = lddt_match.split(":")[1].strip() if lddt_match else "-1"
                        # Foldmason LDDT core (conserved columns only)
                        lddt_core_output = shell(
                            "conda run -n foldmason foldmason msa2lddt {params.workdir}foldmason_db {struct_msa}"
                            + " --pair-threshold 0.5 --only-scoring-cols true"
                            + " --threads {threads}"
                            + " 2>> {log.stderr}",
                            read=True
                        )
                        lddt_core_match = next((
                            line for line in lddt_core_output.splitlines()
                            if line.startswith("Average MSA LDDT:")
                        ), None)
                        lddt_core = lddt_core_match.split(":")[1].strip() if lddt_core_match else "-1"
                    except Exception as foldmason_error:
                        warning = (
                            f"WARNING: foldmason LDDT unavailable for "
                            f"{sample_name}, recording -1: "
                            f"{type(foldmason_error).__name__}: {foldmason_error}"
                        )
                        print(warning)
                        with open(log.stderr, "a") as err_file:
                            print(warning, file=err_file)
                        lddt = "-1"
                        lddt_core = "-1"
                # pylddt muscle LDDT and DALI Z score
                pdbfiles_txt = params.workdir + "/pdbfiles.txt"
                with open(pdbfiles_txt, "w") as pf:
                    import glob
                    for pdb_file in glob.glob(struct_dir + "/*"):
                        pf.write(pdb_file + "\n")
                try:
                    lddt_muscle_output = shell(
                        "python pylddt/src/lddt_mu_par.py"
                        + " --msa {struct_msa}"
                        + " --pdbfiles " + pdbfiles_txt
                        + " --symmetry both"
                        + " --threads {threads}"
                        + " 2>> {log.stderr}",
                        read=True
                    )
                    lddt_muscle = lddt_muscle_output.strip().split("\t")[1] if lddt_muscle_output.strip() else "-1"
                    if params.lddt_muscle_only:
                        dali_z = "-1"
                    else:
                        dali_z_output = shell(
                            "python pylddt/src/daliz_par.py"
                            + " --msa {struct_msa}"
                            + " --pdbfiles " + pdbfiles_txt
                            + " --threads {threads}"
                            + " 2>> {log.stderr}",
                            read=True
                        )
                        dali_z_match = next((
                            line for line in dali_z_output.splitlines()
                            if "mean_DALI_Z" in line
                        ), None)
                        dali_z = dali_z_match.split("=")[-1].strip() if dali_z_match else "-1"
                except Exception:
                    lddt_muscle = "-1"
                    dali_z = "-1"

    else:
        # If project_msa.py fails, create an empty output.proj
        with open(output.proj, 'w') as f:
            pass
        success_flag = 0
        values = ['0'] * 7
        lddt = "0"
        lddt_core = "0"
        lddt_muscle = "0"
        dali_z = "0"

    with open(output.score, 'w') as f:
        f.write(f"{sample_name} {success_flag} {' '.join(values)} {lddt} {lddt_core} {lddt_muscle} {dali_z}")


if not CLEANUP:
    rule score_msa:
        input:
            est = "outputs/"+config["name"]+"/{tool}/alignments/{sample}",
        output:
            proj = "outputs/"+config["name"]+"/{tool}/projections/{sample}",
            score = "outputs/"+config["name"]+"/{tool}/scores/{sample}.score"
        threads: config["score_threads"] if "score_threads" in config else 8
        resources:
            mem_mb = config["score_mem"] if "score_mem" in config else 16000,
            runtime = config["score_runtime"] if "score_runtime" in config else "10m",
        log:
            stdout="outputs/"+config["name"]+"/{tool}/logs/score_{sample}.log",
            stderr="outputs/"+config["name"]+"/{tool}/logs/score_{sample}.err",
        params:
            workdir="outputs/"+config["name"]+"/{tool}/workdirs/{sample}/",
            ref=resolve_ref_path,
            pdb=resolve_pdb_path,
            ref_pdb=resolve_ref_pdb_path,
            lddt_muscle_only=bool(config.get("lddt_muscle_only", False))
        run:
            score_sample(input, output, params, log, threads, wildcards)


rule concat_scores:
    input:
        scores = expand(
            "outputs/"+config["name"]+"/{{tool}}/scores/{sample}.score",
            zip,
            sample=SAMPLES
        ),
        benchmarks = expand(
            "outputs/"+config["name"]+"/{{tool}}/benchmarks/{sample}.txt",
            zip,
            sample=SAMPLES
        )
    output:
        "results/"+config["name"]+"/{tool}.out"
    threads: 1
    resources:
        mem_mb = 1000,
        runtime = "5m"
    run:
        # fold the sidecars into the benchmark files before reading
        for b in input.benchmarks:
            merge_benchmark_column(b, ".gpu", GPU_MEM_COLUMN)
            merge_benchmark_column(b, ".time", TOOL_TIME_COLUMN)

        shell("echo -n 'sample success ' > {output}")
        # write the header
        shell("java -jar FastSP/FastSP.jar"
                +" -r " + data_file("aligned", SAMPLES[0])
                +" -e " + data_file("aligned", SAMPLES[0])
                + " | awk '{{print $1}}' \
                    | tr '\n' ' ' >> {output}")
        shell("echo -n 'lddt lddt_core lddt_muscle dali_z ' >> {output}")
        shell("echo $(head -n 1 " + input.benchmarks[0] + ") >> {output}")

        def normalize_line(line):
            """Convert 'N day[s], h:m:s' to 'h:m:s' and replace tabs with spaces."""
            import re
            line = re.sub(
                r'(\d+) days?,\s*(\d+):(\d+):(\d+)',
                lambda m: f"{int(m.group(1)) * 24 + int(m.group(2))}:{m.group(3)}:{m.group(4)}",
                line
            )
            return line.replace('\t', ' ')

        for s,b in zip(input.scores, input.benchmarks):
            #row by row for each sample, concatenate the scores and the second
            # line of the benchmark file, fixing any "N day[s], h:m:s" values
            # and normalizing tabs to spaces
            with open(b) as bf:
                bench_line = normalize_line(bf.readlines()[1].strip())
            with open(s) as sf:
                score_line = sf.read().strip()
            with open(output[0], 'a') as out:
                out.write(f"{score_line} {bench_line}\n")
