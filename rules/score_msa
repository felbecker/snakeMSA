# type: ignore

GPU_MEM_COLUMN = "max_gpu_mem"


def merge_gpu_column(bench_path, column=GPU_MEM_COLUMN):
    """Append the GPU memory sidecar value to a snakemake benchmark file.

    The align rule cannot write this itself: snakemake overwrites the benchmark
    file after the rule returns, so the value is parked in a sibling ".gpu" file
    and folded in here. Benchmark files without a sidecar (e.g. from runs made
    before GPU tracking existed) get -1. Idempotent, so re-running this rule
    does not add the column twice.
    """
    with open(bench_path) as bench_file:
        lines = bench_file.read().splitlines()
    if not lines or column in lines[0].split("\t"):
        return

    gpu_path = os.path.splitext(bench_path)[0] + ".gpu"
    try:
        with open(gpu_path) as gpu_file:
            value = gpu_file.read().strip() or "-1"
    except FileNotFoundError:
        value = "-1"

    lines[0] += "\t" + column
    for i in range(1, len(lines)):
        lines[i] += "\t" + value

    # write via a temporary file so a crash cannot truncate the benchmark
    tmp_path = bench_path + ".tmp"
    with open(tmp_path, "w") as tmp_file:
        tmp_file.write("\n".join(lines) + "\n")
    os.replace(tmp_path, bench_path)


rule score_msa:
    input:
        est = "outputs/"+config["name"]+"/{tool}/alignments/{sample}",
    output:
        proj = "outputs/"+config["name"]+"/{tool}/projections/{sample}",
        score = "outputs/"+config["name"]+"/{tool}/scores/{sample}.score"
    threads: config["score_threads"] if "score_threads" in config else 8
    resources:
        mem_mb = config["score_mem"] if "score_mem" in config else 16000,
        runtime = "120m"
    log:
        stdout="outputs/"+config["name"]+"/{tool}/logs/score_{sample}.log",
        stderr="outputs/"+config["name"]+"/{tool}/logs/score_{sample}.err",
    params:
        workdir="outputs/"+config["name"]+"/{tool}/workdirs/{sample}/",
        ref=lambda wildcards: (
            ref_path
            if os.path.exists(ref_path := config["data_path"]+"/aligned/"+wildcards.sample)
            else ""
        ),
        pdb=lambda wildcards: (
            config["data_path"] + "/" + config.get("pdb", "") + "/"
            + os.path.splitext(wildcards.sample)[0]
            if "pdb" in config else ""
        ),
        lddt_muscle_only=bool(config.get("lddt_muscle_only", False))
    run:
        # Ensure log directory exists before any shell calls write to it
        os.makedirs(os.path.dirname(log.stdout), exist_ok=True)

        msa_failed = False
        with open(input.est, "r") as est_file:
            if est_file.readline().strip() == "FAILED":
                msa_failed = True

        # strip the extension from the sample name
        sample_name = os.path.basename(wildcards.sample).rsplit('.', 1)[0]

        # Create folders if they do not exist
        os.makedirs(os.path.dirname(output.proj), exist_ok=True)
        os.makedirs(os.path.dirname(output.score), exist_ok=True)

        if not msa_failed:

            success_flag = 1
            if params.ref == "":
                # no reference MSA available: skip projection/FastSP scoring
                import shutil
                shutil.copyfile(input.est, output.proj)
                values = ['-1'] * 7
            else:
                # first project the estimated msa w.r.t. the reference sequences
                shell(
                    "python tools/project_msa.py"
                    + " --msa {input.est}"
                    + " --ref {params.ref}"
                    + " --out {output.proj}"
                    + " >> {log.stdout} 2>> {log.stderr}"
                )
                # compute scores
                fastsp_output = shell(
                    "java -jar FastSP/FastSP.jar -r {params.ref} -e {output.proj} -mlr"
                    + " 2>> {log.stderr}",
                    read=True
                )
                # write it with the scores into a single line
                values = [
                    line.split()[1] for line in fastsp_output.strip().split('\n')
                ]

            # compute lddt scores using foldmason and pylddt
            if params.pdb == "":
                lddt = "-1"
                lddt_core = "-1"
                lddt_muscle = "-1"
                dali_z = "-1"
            else:
                if not os.path.exists(params.pdb):
                    lddt = "-1"
                    lddt_core = "-1"
                    lddt_muscle = "-1"
                    dali_z = "-1"
                else:
                    os.makedirs(params.workdir, exist_ok=True)
                    if params.lddt_muscle_only:
                        # only pylddt's muscle LDDT is requested; foldmason is
                        # the expensive part, so skip it entirely
                        lddt = "-1"
                        lddt_core = "-1"
                    else:
                        # foldmason (msa2lddt in particular) can segfault on certain
                        # inputs due to bugs in the upstream binary; don't let that
                        # abort the whole run, just record -1 for this sample.
                        try:
                            shell(
                                "foldmason createdb {params.pdb} {params.workdir}/foldmason_db"
                                + " --threads {threads}"
                                + " >> {log.stdout} 2>> {log.stderr}"
                            )
                            # Standard foldmason LDDT
                            lddt_output = shell(
                                "foldmason msa2lddt {params.workdir}/foldmason_db {output.proj}"
                                + " --threads {threads}"
                                + " 2>> {log.stderr}",
                                read=True
                            )
                            lddt_match = next((
                                line for line in lddt_output.splitlines()
                                if line.startswith("Average MSA LDDT:")
                            ), None)
                            lddt = lddt_match.split(":")[1].strip() if lddt_match else "-1"
                            # Foldmason LDDT core (conserved columns only)
                            lddt_core_output = shell(
                                "foldmason msa2lddt {params.workdir}/foldmason_db {output.proj}"
                                + " --pair-threshold 1.0 --only-scoring-cols true"
                                + " --threads {threads}"
                                + " 2>> {log.stderr}",
                                read=True
                            )
                            lddt_core_match = next((
                                line for line in lddt_core_output.splitlines()
                                if line.startswith("Average MSA LDDT:")
                            ), None)
                            lddt_core = lddt_core_match.split(":")[1].strip() if lddt_core_match else "-1"
                        except Exception:
                            lddt = "-1"
                            lddt_core = "-1"
                    # pylddt muscle LDDT and DALI Z score
                    pdbfiles_txt = params.workdir + "/pdbfiles.txt"
                    with open(pdbfiles_txt, "w") as pf:
                        import glob
                        for pdb_file in glob.glob(params.pdb + "/*"):
                            pf.write(pdb_file + "\n")
                    try:
                        lddt_muscle_output = shell(
                            "python pylddt/src/lddt_mu_par.py"
                            + " --msa {output.proj}"
                            + " --pdbfiles " + pdbfiles_txt
                            + " --threads {threads}"
                            + " 2>> {log.stderr}",
                            read=True
                        )
                        lddt_muscle = lddt_muscle_output.strip().split("\t")[1] if lddt_muscle_output.strip() else "-1"
                        if params.lddt_muscle_only:
                            dali_z = "-1"
                        else:
                            dali_z_output = shell(
                                "python pylddt/src/daliz.py"
                                + " --msa {output.proj}"
                                + " --pdbfiles " + pdbfiles_txt
                                + " 2>> {log.stderr}",
                                read=True
                            )
                            dali_z_match = next((
                                line for line in dali_z_output.splitlines()
                                if "mean_DALI_Z" in line
                            ), None)
                            dali_z = dali_z_match.split("=")[-1].strip() if dali_z_match else "-1"
                    except Exception:
                        lddt_muscle = "-1"
                        dali_z = "-1"

        else:
            # If project_msa.py fails, create an empty output.proj
            with open(output.proj, 'w') as f:
                pass
            success_flag = 0
            values = ['0'] * 7
            lddt = "0"
            lddt_core = "0"
            lddt_muscle = "0"
            dali_z = "0"

        with open(output.score, 'w') as f:
            f.write(f"{sample_name} {success_flag} {' '.join(values)} {lddt} {lddt_core} {lddt_muscle} {dali_z}")


rule concat_scores:
    input:
        scores = expand(
            "outputs/"+config["name"]+"/{{tool}}/scores/{sample}.score",
            zip,
            sample=SAMPLES
        ),
        benchmarks = expand(
            "outputs/"+config["name"]+"/{{tool}}/benchmarks/{sample}.txt",
            zip,
            sample=SAMPLES
        )
    output:
        "results/"+config["name"]+"/{tool}.out"
    threads: 1
    resources:
        mem_mb = 1000,
        runtime = "5m"
    run:
        # fold the GPU memory sidecars into the benchmark files before reading
        for b in input.benchmarks:
            merge_gpu_column(b)

        shell("echo -n 'sample success ' > {output}")
        # write the header
        shell("java -jar FastSP/FastSP.jar"
                +" -r " + config["data_path"]+"/aligned/"+SAMPLES[0]
                +" -e " + config["data_path"]+"/aligned/"+SAMPLES[0]
                + " | awk '{{print $1}}' \
                    | tr '\n' ' ' >> {output}")
        shell("echo -n 'lddt lddt_core lddt_muscle dali_z ' >> {output}")
        shell("echo $(head -n 1 " + input.benchmarks[0] + ") >> {output}")

        def normalize_line(line):
            """Convert 'N day[s], h:m:s' to 'h:m:s' and replace tabs with spaces."""
            import re
            line = re.sub(
                r'(\d+) days?,\s*(\d+):(\d+):(\d+)',
                lambda m: f"{int(m.group(1)) * 24 + int(m.group(2))}:{m.group(3)}:{m.group(4)}",
                line
            )
            return line.replace('\t', ' ')

        for s,b in zip(input.scores, input.benchmarks):
            #row by row for each sample, concatenate the scores and the second
            # line of the benchmark file, fixing any "N day[s], h:m:s" values
            # and normalizing tabs to spaces
            with open(b) as bf:
                bench_line = normalize_line(bf.readlines()[1].strip())
            with open(s) as sf:
                score_line = sf.read().strip()
            with open(output[0], 'a') as out:
                out.write(f"{score_line} {bench_line}\n")
