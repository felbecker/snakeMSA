# type: ignore
import sys
import glob

# Out-of-process GPU memory tracking, so that any GPU tool can be measured
# without instrumenting it (see tools/gpu_monitor.py).
sys.path.insert(0, os.path.join(workflow.basedir, "tools"))
import gpu_monitor


def resolve_struct_path(wildcards):
    if "struct_data" not in config:
        return ""
    struct_dir = config["data_path"] + "/" + config.get("struct_data", "")
    basename = os.path.splitext(wildcards.sample)[0]
    matches = sorted(glob.glob(struct_dir + "/" + basename + ".*"))
    if matches:
        return matches[0]
    # struct files may have no extension at all
    no_ext = struct_dir + "/" + basename
    return no_ext if os.path.exists(no_ext) else ""


rule align:
    input:
        config["data_path"]+"/unaligned/{sample}"
    output:
        "outputs/"+config["name"]+"/{tool}/alignments/{sample}"
    threads: config["align_threads"] if "align_threads" in config else 8
    resources:
        mem_mb = config["align_mem"] if "align_mem" in config else 64000,
        gpu = lambda _: 1 if config["use_gpu"] else 0,
        runtime = config["align_runtime"] if "align_runtime" in config else "1d"
    log:
        stdout="outputs/"+config["name"]+"/{tool}/logs/{sample}.log",
        stderr="outputs/"+config["name"]+"/{tool}/logs/{sample}.err",
    benchmark:
        "outputs/"+config["name"]+"/{tool}/benchmarks/{sample}.txt"
    params:
        workdir="outputs/"+config["name"]+"/{tool}/workdirs/{sample}/",
        tree="outputs/"+config["name"]+"/{tool}/trees/{sample}/",
        struct=resolve_struct_path,
        emb=lambda wildcards: (
            config["data_path"] + "/" + config.get("emb_data", "") + "/"
            + os.path.splitext(wildcards.sample)[0] + ".emb"
            if "emb_data" in config else ""
        ),
        pdb=lambda wildcards: (
            config["data_path"] + "/" + config.get("pdb", "") + "/"
            + os.path.splitext(wildcards.sample)[0]
            if "pdb" in config else ""
        ),
        gpu_bench="outputs/"+config["name"]+"/{tool}/benchmarks/{sample}.gpu"
    run:
        tool_command=config["tools"][wildcards.tool]["command"]
        argstring = parse_cmd_args(config["tools"][wildcards.tool]["params"])

        # Make sure workdir exists before running the command
        os.makedirs(params.workdir, exist_ok=True)

        cmd = (tool_command + " " + argstring).format(
            input=input,
            output=output,
            threads=threads,
            workdir=params.workdir,
            tree=params.tree,
            struct=params.struct,
            emb=params.emb,
            pdb=params.pdb,
        )

        print("Running command: ", cmd)

        if "mafft" in wildcards.tool:
            cmd += " > {output}".format(output=output[0])

        p = subprocess.Popen(
            cmd,
            shell = True,
            stdout = subprocess.PIPE,
            stderr= subprocess.PIPE
        )
        # Track peak GPU memory of the command and all of its children for the
        # duration of the run. Snakemake writes the benchmark file only after
        # this rule returns, so the result goes to a sidecar that concat_scores
        # merges into the benchmark file.
        monitor = None
        if config.get("use_gpu") and gpu_monitor.gpu_available():
            monitor = gpu_monitor.GPUMemoryMonitor(p.pid).start()

        try:
            stdout, stderr= p.communicate()
        finally:
            peak_gpu_mb = (
                monitor.stop() if monitor is not None else gpu_monitor.NULL_GPU_MEM
            )
            os.makedirs(os.path.dirname(params.gpu_bench), exist_ok=True)
            with open(params.gpu_bench, "w") as gpu_file:
                gpu_file.write(str(peak_gpu_mb))

        with open(log.stderr, "w") as err_file:
            print(stderr.decode(), file=err_file)

        with open(log.stdout, "w") as log_file:
            print(stdout.decode(), file=log_file)

        if not (
            os.path.exists(output[0])
            and p.returncode == 0
            and not os.path.getsize(output[0]) == 0
        ):
            # something went wrong
            # create the output file to make subsequent rules still run,
            # but make clear that the output file is invalid
            with open(output[0], "w") as fout:
                fout.write("FAILED")


def parse_cmd_args(params):
    """
    Converts a dictionary to a string of command-line arguments.

    Args:
        params (dict): Dictionary of parameters.

    Returns:
        str: Command-line arguments as a string.
    """
    return " ".join(params)