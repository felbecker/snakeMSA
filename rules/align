def resolve_struct_path(wildcards):
    if "struct_data" not in config:
        return ""
    struct_dir = data_file(config["struct_data"])
    basename = os.path.splitext(wildcards.sample)[0]
    matches = sorted(glob.glob(os.path.join(struct_dir, basename + ".*")))
    if matches:
        return matches[0]
    # struct files may have no extension at all
    no_ext = os.path.join(struct_dir, basename)
    return no_ext if os.path.exists(no_ext) else ""


def resolve_emb_path(wildcards):
    if "emb_data" not in config:
        return ""
    return data_file(
        config["emb_data"], os.path.splitext(wildcards.sample)[0] + ".emb"
    )


# "conda run [options] -n ENV " after optional "VAR=value " assignments
CONDA_RUN = re.compile(
    r"^((?:\S+=\S*\s+)*)conda\s+run(?:\s+--?[\w-]+)*?\s+(?:-n|--name)\s+(\S+)\s+"
)


def resolve_conda_run(cmd):
    """Split off a leading `conda run -n ENV` from cmd.

    Returns the command without it and the environment that `conda run`
    would give it, so that conda starts before the tool is timed. Commands
    without `conda run` keep the current environment.
    """
    match = CONDA_RUN.match(cmd)
    if match is None:
        return cmd, dict(os.environ)
    env_name = match.group(2)
    conda_exe = os.environ.get("CONDA_EXE", "conda")
    result = subprocess.run(
        [conda_exe, "run", "-n", env_name, "env", "-0"], capture_output=True
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"could not activate conda env {env_name}: "
            + result.stderr.decode()
        )
    env = {}
    for entry in result.stdout.decode().split("\0"):
        key, sep, value = entry.strip("\n").partition("=")
        if sep:
            env[key] = value
    return match.group(1) + cmd[match.end():], env


def absolute_command_paths(command):
    """Make the relative paths in a tool command (e.g. bin/famsa,
    tools/mafft_3di.sh) absolute, so it can run in another directory."""
    return " ".join(
        os.path.abspath(token)
        if "/" in token and not os.path.isabs(token) and os.path.exists(token)
        else token
        for token in command.split(" ")
    )


def copy_to(path, directory):
    """Copy a file or directory into directory and return the new path."""
    target = os.path.join(directory, os.path.basename(path.rstrip("/")))
    if os.path.isdir(path):
        shutil.copytree(path, target)
    else:
        shutil.copy(path, target)
    return target


def remove_tree(root):
    """Delete root, including read-only parts (e.g. copied pdb dirs with
    their source permissions) that a plain rmtree cannot remove."""
    root = os.path.abspath(root)
    def make_writable_and_retry(func, path, _):
        path = os.path.abspath(path)
        if path != root:
            os.chmod(os.path.dirname(path), 0o700)
        if os.path.isdir(path) and not os.path.islink(path):
            os.chmod(path, 0o700)
        func(path)
    # onexc is new in Python 3.12; the snakemake env on the cluster has 3.11
    if sys.version_info >= (3, 12):
        shutil.rmtree(root, onexc=make_writable_and_retry)
    else:
        shutil.rmtree(root, onerror=make_writable_and_retry)


# Scratch dirs are named after host and pid of the job that owns them, so
# that a later job can tell when they are orphaned.
SCRATCH_HOST_PREFIX = f"snakeMSA_{socket.gethostname()}_"


def remove_orphaned_scratch(scratch_dir):
    """Delete scratch dirs of dead jobs on this host. A job that is killed
    (SIGKILL, OOM, SIGTERM, which the run thread cannot handle) never reaches
    its own cleanup."""
    pattern = os.path.join(scratch_dir, SCRATCH_HOST_PREFIX + "*_*")
    for path in glob.glob(pattern):
        name = os.path.basename(path)
        pid = name[len(SCRATCH_HOST_PREFIX):].split("_")[0]
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            try:
                remove_tree(path)
            except OSError as error:
                # e.g. the dir of another user on a shared node
                print(f"Could not remove orphaned scratch {path}: {error}")
        except (ValueError, PermissionError):
            pass  # not a pid or the process is alive


def copy_back_from_scratch(scratch, paths, output, params):
    """Move the outputs of a tool that ran in scratch to their real paths."""
    # everything the tool wrote next to its output, e.g. output.gz
    out_dir = os.path.join(scratch, "output")
    for name in os.listdir(out_dir):
        shutil.move(
            os.path.join(out_dir, name),
            os.path.join(os.path.dirname(output.msa), name),
        )
    if os.path.exists(paths["tree"]):
        shutil.move(paths["tree"], params.tree)
    # keep symlinks as they are: tools leave dangling ones in their workdir
    # (e.g. the mmseqs tmp dir of learnMSA). Replace the workdir of a
    # previous run, whose links would collide.
    remove_tree(params.workdir)
    shutil.copytree(
        paths["workdir"], params.workdir, symlinks=True, dirs_exist_ok=True
    )


def align_sample(input, output, params, log, threads, wildcards):
    """Run the configured tool on input.unaligned and write output.msa.

    Shared by the align rule and the fused align_and_score rule (cleanup
    mode). The arguments only need attribute access to the fields used here.

    Only the tool process is timed (written to params.tool_bench). Starting
    its conda env, and with the "scratch" config flag (default on) copying
    the inputs to node-local scratch and the outputs back, happen outside of
    that time: on a slow shared filesystem they can take longer than the
    alignment itself.
    """
    tool_command=config["tools"][wildcards.tool]["command"]
    argstring = parse_cmd_args(config["tools"][wildcards.tool]["params"])

    # Make sure workdir and the directory of the tree file exist before
    # running the command
    os.makedirs(params.workdir, exist_ok=True)
    os.makedirs(os.path.dirname(params.tree), exist_ok=True)

    # -1 until the tool has run successfully
    os.makedirs(os.path.dirname(params.tool_bench), exist_ok=True)
    with open(params.tool_bench, "w") as time_file:
        time_file.write("-1")

    # Tools that compress their output (learnMSA --compress) append ".gz" to
    # the output path. Remove a stale one so a failed run cannot pick it up.
    compressed_msa = output.msa + ".gz"
    if os.path.exists(compressed_msa):
        os.remove(compressed_msa)

    paths = dict(
        input=input.unaligned,
        output=output.msa,
        # a line starting with "workdir" outside of a rule would be parsed as
        # the snakemake workdir directive
        tree=params.tree, workdir=params.workdir,
        struct=params.struct,
        emb=params.emb,
        pdb=params.pdb,
    )
    scratch = None
    # copy back only what a started tool wrote, not a half set up scratch
    tool_started = False
    try:
        if config_flag("scratch", True):
            scratch_dir = config.get("scratch_dir") or tempfile.gettempdir()
            remove_orphaned_scratch(scratch_dir)
            scratch = tempfile.mkdtemp(
                prefix=f"{SCRATCH_HOST_PREFIX}{os.getpid()}_",
                dir=scratch_dir,
            )
            for key in ("input", "struct", "emb", "pdb"):
                if paths[key] and os.path.exists(paths[key]):
                    os.makedirs(os.path.join(scratch, key))
                    paths[key] = copy_to(
                        paths[key], os.path.join(scratch, key)
                    )
                elif paths[key]:
                    paths[key] = os.path.abspath(paths[key])
            for key in ("output", "tree"):
                os.makedirs(os.path.join(scratch, key))
                paths[key] = os.path.join(
                    scratch, key, os.path.basename(paths[key])
                )
            paths["workdir"] = os.path.join(scratch, "workdir") + "/"
            os.makedirs(paths["workdir"])
            tool_command = absolute_command_paths(tool_command)

        cmd = (tool_command + " " + argstring).format(
            threads=threads, **paths
        )

        print("Running command: ", cmd)

        if "mafft" in wildcards.tool:
            cmd += " > {output}".format(output=paths["output"])

        cmd, env = resolve_conda_run(cmd)

        start = time.monotonic()
        p = subprocess.Popen(
            cmd,
            shell = True,
            stdout = subprocess.PIPE,
            stderr= subprocess.PIPE,
            cwd = scratch,
            env = env,
        )
        tool_started = True
        # Track peak GPU memory of the command and all of its children for
        # the duration of the run. Snakemake writes the benchmark file only
        # after this rule returns, so the result goes to a sidecar that
        # concat_scores merges into the benchmark file.
        monitor = None
        if config.get("use_gpu") and gpu_monitor.gpu_available():
            monitor = gpu_monitor.GPUMemoryMonitor(p.pid).start()

        try:
            stdout, stderr= p.communicate()
        finally:
            tool_seconds = time.monotonic() - start
            peak_gpu_mb = (
                monitor.stop() if monitor is not None
                else gpu_monitor.NULL_GPU_MEM
            )
            os.makedirs(os.path.dirname(params.gpu_bench), exist_ok=True)
            with open(params.gpu_bench, "w") as gpu_file:
                gpu_file.write(str(peak_gpu_mb))

        with open(log.stderr, "w") as err_file:
            print(stderr.decode(), file=err_file)

        with open(log.stdout, "w") as log_file:
            print(stdout.decode(), file=log_file)
    finally:
        if scratch is not None:
            try:
                if tool_started:
                    copy_back_from_scratch(scratch, paths, output, params)
            finally:
                remove_tree(scratch)

    # Keep a compressed MSA gzipped under the expected name; scoring detects
    # the compression from the content (tools/project_msa.py).
    if not os.path.exists(output.msa) and os.path.exists(compressed_msa):
        os.replace(compressed_msa, output.msa)

    if not (
        os.path.exists(output.msa)
        and p.returncode == 0
        and not os.path.getsize(output.msa) == 0
    ):
        # something went wrong
        # create the output file to make subsequent rules still run,
        # but make clear that the output file is invalid
        with open(output.msa, "w") as fout:
            fout.write("FAILED")
    else:
        with open(params.tool_bench, "w") as time_file:
            time_file.write(f"{tool_seconds:.4f}")


